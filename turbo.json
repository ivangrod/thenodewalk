{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CHROMA_URL", "OLLAMA_URL", "OLLAMA_EMBEDDING_MODEL", "OLLAMA_LLM_MODEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_URL"],
      "outputs": [".next/**", "dist/**", "!dist/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:architecture": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [
        "playwright-report/**",
        "test-results/**",
        "cypress/videos/**",
        "cypress/screenshots/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
