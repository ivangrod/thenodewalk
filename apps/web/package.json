{
  "name": "@thenodewalk/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "lint": "eslint .",
    "lint:architecture": "eslint --config eslint.architecture.config.mjs src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test dev http://127.0.0.1:3000 e2e:run",
    "e2e:run": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "@thenodewalk/contracts": "workspace:*",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.511.0",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.0",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.23.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.7",
    "@testing-library/jest-dom": "6.7.0",
    "@testing-library/react": "16.3.0",
    "@thenodewalk/typescript-config": "workspace:*",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.23.0",
    "eslint-config-next": "15.5.23",
    "eslint-plugin-boundaries": "5.0.0",
    "jsdom": "26.1.0",
    "start-server-and-test": "2.0.11",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.2"
  }
}
