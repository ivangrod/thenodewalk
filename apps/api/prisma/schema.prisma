generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FeedLastPublicationDate {
  id              String   @id @default(uuid())
  blogName        String   @unique
  feedUrl         String
  lastPublishedAt DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("feed_last_publication_dates")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  mindMaps  MindMap[]
}

model IngestedBook {
  bookId     String   @id @map("book_id")
  filePath   String   @map("file_path")
  title      String
  chunkCount Int      @map("chunk_count")
  ingestedAt DateTime @db.Timestamptz(3) @map("ingested_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("ingested_books")
}

model MindMap {
  id        String      @id @default(cuid())
  title     String
  ownerId   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nodes     MindMapNode[]
  edges     MindMapEdge[]

  @@index([ownerId])
}

model MindMapNode {
  id        String        @id @default(cuid())
  mindMapId String
  title     String
  content   Json?
  position  Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  mindMap   MindMap       @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  sourceOf  MindMapEdge[] @relation("SourceNode")
  targetOf  MindMapEdge[] @relation("TargetNode")

  @@index([mindMapId])
}

model MindMapEdge {
  id           String      @id @default(cuid())
  mindMapId    String
  sourceNodeId String
  targetNodeId String
  createdAt    DateTime    @default(now())
  mindMap      MindMap     @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  sourceNode   MindMapNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   MindMapNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([mindMapId])
}
