# Local PostgreSQL started with `pnpm infra:up`.
DATABASE_URL="postgresql://thenodewalk:thenodewalk@localhost:5432/thenodewalk?schema=public"

# Local ChromaDB vector store started with `pnpm infra:up`.
CHROMA_URL="http://localhost:8000"

# Local Ollama runtime (install from https://ollama.com) with the required models pulled:
#   ollama pull nomic-embed-text
#   ollama pull llama3.1:8b
OLLAMA_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_LLM_MODEL="llama3.1:8b"
