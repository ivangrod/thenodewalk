{
  "name": "@thenodewalk/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint .",
    "lint:architecture": "eslint --config eslint.architecture.config.mjs src",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "test:e2e": "start-server-and-test dev http://127.0.0.1:3001/health e2e:run",
    "e2e:run": "cypress run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@prisma/client": "6.19.3",
    "@thenodewalk/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@thenodewalk/typescript-config": "workspace:*",
    "@eslint/js": "9.23.0",
    "@nestjs/cli": "11.0.7",
    "@nestjs/testing": "11.1.29",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.3",
    "@types/supertest": "7.2.1",
    "@vercel/node": "5.10.0",
    "cypress": "15.20.1",
    "eslint": "9.23.0",
    "eslint-plugin-boundaries": "5.0.0",
    "jest": "30.4.2",
    "prisma": "6.19.3",
    "start-server-and-test": "2.0.11",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.0"
  }
}
